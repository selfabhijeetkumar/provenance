# PROVENANCE — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ── AI Gateway (required) ───────────────────────────────────────────────────
# OpenAI-compatible endpoint. Works with:
#   - Local gemini-web2api proxy: http://127.0.0.1:8081/v1
#   - Google Gemini API (via OpenAI compat layer): https://generativelanguage.googleapis.com/v1beta/openai
#   - Any OpenAI-compatible hosted service
GEMINI_BASE_URL=

# API key for the gateway above
GEMINI_API_KEY=

# Model name to use (must match what your gateway supports)
GEMINI_MODEL=gemini-2.0-flash

# ── Optional: Publish webhook ───────────────────────────────────────────────
# n8n-compatible POST fired when a paper is published.
# Leave blank to skip.
# PUBLISH_WEBHOOK_URL=
