# PROVENANCE — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ── AI Gateway (required) ───────────────────────────────────────────────────
# OpenAI-compatible endpoint. Works with:
#   - Google Gemini API (via OpenAI compat layer — recommended):
#     https://generativelanguage.googleapis.com/v1beta/openai
#   - Local gemini-web2api proxy: http://127.0.0.1:8081/v1
#   - Any OpenAI-compatible hosted service
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# API key for the gateway above (Google AI Studio key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-google-ai-studio-key-here

# Model name to use (must match what your gateway supports)
GEMINI_MODEL=gemini-3.8-flash

# ── Optional: Publish webhook ───────────────────────────────────────────────
# n8n-compatible POST fired when a paper is published.
# Leave blank to skip.
# PUBLISH_WEBHOOK_URL=
